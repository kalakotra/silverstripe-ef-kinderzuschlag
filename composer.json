{
    "name": "kalakotra/silverstripe-ef-kinderzuschlag",
    "description": "Antrag auf Kinderzuschlag (Familienkasse KiZ 1 with Anlagen KiZ 1-AnA, 1-AnK, 5, 5a, 5c, 6, 7 and Kurzantrag KiZ 1-K). Form module for the e-formulare.de PDF filler (requires the pdf-editor app base classes).",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "pdf",
        "e-formulare",
        "kinderzuschlag",
        "familienkasse",
        "kiz"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/multiform": "^3.0@dev",
        "unclecheese/display-logic": "^4.0",
        "mikehaertl/php-pdftk": "^0.14",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Kalakotra\\EFormKinderzuschlag\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
